{"hash":"00108cced171","game":"trenches","config":{"title":"In the Trenches","start_year":1914,"regnal_king":"George","reigns":[],"attributes":["body"],"skills":["soldiering"],"stations":["ranker"],"tracks":["service"],"seasons":["spring","summer","autumn","winter"],"chapters":["enlist","front","end"],"in_progress":[],"counter_labels":{},"aliases":[],"chapter_cards":{"enlist":{"title":"Kitchener's Army","subtitle":"Autumn 1914","epigraph":"Your country needs you."},"front":{"title":"France","subtitle":"The line","epigraph":"Front line, support, reserve, rest. Then the front line."}}},"registry":{"flags":{},"npcs":{},"traits":{},"injuries":{},"items":{},"factions":{},"endings":{"armistice":{"label":"The Armistice","description":"Alive on 11 November 1918.","chapter":"end"},"posting":{"label":"A home posting","description":"Took a posting at home on leave; his war ended there.","chapter":"end"},"captured":{"label":"Taken prisoner","description":"Overrun and taken; the war ended for him behind the wire.","chapter":"end"},"invalided":{"label":"Wounded out","description":"A wound that downgraded him; home service or discharge.","chapter":"end"},"killed":{"label":"Killed","description":"Killed in France.","chapter":"end"},"broken":{"label":"Shell shock","description":"His nerve went; evacuated.","chapter":"end"},"court_martial":{"label":"Court-martial","description":"Charged with cowardice after freezing under fire.","chapter":"end"},"error":{"label":"Lost track","description":"A content bug: the war asked a question no scene answers.","chapter":"end"}},"lore":{},"places":{}},"scenes":{"c_enlist_mill":{"id":"c_enlist_mill","chapter":"enlist","kind":"spine","title":"The recruiting office","tags":[],"weight":10,"once":true,"checkpoint":true,"text":"You are {age}. The mill has let the men go to enlist and promised the jobs\nback. Half your street is in the queue at the drill hall, and they are taking the whole street\ntogether, into one company.\n[break]\nWhat you bring from the mill is what you will have out there.\n","on_enter":[],"choices":[{"id":"pick_0","text":"Bring a hand with machinery, and stamina from a long working day.","tags":[],"lethal":false,"effects":[{"war_home":["mech","stamina"]}],"next":"c_general"},{"id":"pick_1","text":"Bring a hand with machinery, and a chapel voice.","tags":[],"lethal":false,"effects":[{"war_home":["mech","voice"]}],"next":"c_general"},{"id":"pick_2","text":"Bring stamina from a long working day, and a chapel voice.","tags":[],"lethal":false,"effects":[{"war_home":["stamina","voice"]}],"next":"c_general"}]},"c_enlist_pit":{"id":"c_enlist_pit","chapter":"enlist","kind":"spine","title":"The recruiting office","tags":[],"weight":10,"once":true,"checkpoint":true,"text":"You are {age}. The colliery band played the first lot to the station.\nThe manager says coal is war work too, but the queue at the welfare hall is longer than the\nshift at the pithead.\n[break]\nWhat you bring from underground is what you will have out there.\n","on_enter":[],"choices":[{"id":"pick_0","text":"Bring digging and timbering, and stamina from a long working day.","tags":[],"lethal":false,"effects":[{"war_home":["dig","stamina"]}],"next":"c_general"},{"id":"pick_1","text":"Bring digging and timbering, and a hand with machinery.","tags":[],"lethal":false,"effects":[{"war_home":["dig","mech"]}],"next":"c_general"},{"id":"pick_2","text":"Bring stamina from a long working day, and a hand with machinery.","tags":[],"lethal":false,"effects":[{"war_home":["stamina","mech"]}],"next":"c_general"}]},"c_enlist_city":{"id":"c_enlist_city","chapter":"enlist","kind":"spine","title":"The recruiting office","tags":[],"weight":10,"once":true,"checkpoint":true,"text":"You are {age}. The office manager shook your hand and said the firm would\nmake up your pay. The clerks are going together, a company of them, from desks all over the city.\n[break]\nWhat you bring from the office is what you will have out there.\n","on_enter":[],"choices":[{